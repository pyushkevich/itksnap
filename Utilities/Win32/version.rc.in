// Version resource for ITK-SNAP executables. This file is configured by CMake
// (see snap_add_version_resource in CMakeLists.txt) once for each executable.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @SNAP_VERSION_MAJOR@,@SNAP_VERSION_MINOR@,@SNAP_VERSION_PATCH@,0
 PRODUCTVERSION  @SNAP_VERSION_MAJOR@,@SNAP_VERSION_MINOR@,@SNAP_VERSION_PATCH@,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "@CPACK_PACKAGE_VENDOR@"
      VALUE "FileDescription",  "@SNAP_RC_DESCRIPTION@"
      VALUE "FileVersion",      "@SNAP_VERSION_FULL@"
      VALUE "InternalName",     "@SNAP_RC_TARGET@"
      VALUE "LegalCopyright",   "Copyright (C) 1998-@SNAP_RC_YEAR@ The ITK-SNAP Developers"
      VALUE "OriginalFilename", "@SNAP_RC_TARGET@.exe"
      VALUE "ProductName",      "ITK-SNAP"
      VALUE "ProductVersion",   "@SNAP_VERSION_FULL@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
